{
  "dashboard": {
    "id": null,
    "uid": "alerts-enabled-disk-memory-monitoring",
    "title": "Alerts Enabled Disk and Memory Monitoring Dashboard",
    "tags": ["memory", "disk", "system", "monitoring", "alerts", "physical", "virtual"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "System Memory Overview",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "Used Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "decimals": 2,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 20000000000
                },
                {
                  "color": "red",
                  "value": 25000000000
                }
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "alert": {
          "name": "High Memory Usage Alert",
          "conditions": [
            {
              "type": "query",
              "query": {
                "params": [
                  "A",
                  "5m",
                  "now"
                ]
              },
              "reducer": {
                "type": "max",
                "params": []
              },
              "evaluator": {
                "type": "gt",
                "params": [25000000000]
              }
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "noDataState": "no_data",
          "notifications": []
        }
      },
