{
  "name": "SearXNG MCP Search Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "query",
              "value": "open source search engines"
            },
            {
              "name": "categories",
              "value": "general"
            },
            {
              "name": "language",
              "value": "en"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Search Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://searxng-mcp-http:5000/api/search",
        "options": {},
        "jsonParameters": true,
        "sendBody": true,
        "bodyParameters": {
          "query": "={{ $node["Set Search Parameters"].json["query"] }}",
          "categories": "={{ $node["Set Search Parameters"].json["categories"] }}",
          "language": "={{ $node["Set Search Parameters"].json["language"] }}"
        }
      },
      "name": "SearXNG MCP Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process SearXNG MCP results\nconst results = $input.all()[0].json.result.results;\n\nreturn results.map((result, index) => ({\n  json: {\n    id: index + 1,\n    title: result.title,\n    url: result.url,\n    content: result.content.substring(0, 200) + (result.content.length > 200 ? '...' : ''),\n    engine: result.engine,\n    score: result.score,\n    query: $input.all()[0].json.result.query\n  }\n}));"
      },
      "name": "Process Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $node["SearXNG MCP Search"].json["result"]["total_results"] }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "name": "Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "SUCCESS"
            },
            {
              "name": "message",
              "value": "Found {{ $node["SearXNG MCP Search"].json["result"]["total_results"] }} results for query: {{ $node["Set Search Parameters"].json["query"] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Success Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1250,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "ERROR"
            },
            {
              "name": "message",
              "value": "No results found for query: {{ $node["Set Search Parameters"].json["query"] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1250,
        400
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "workflowStatus",
              "value": "={{ $node["Has Results?"].json["status"] }}"
            },
            {
              "name": "workflowMessage",
              "value": "={{ $node["Has Results?"].json["message"] }}"
            },
            {
              "name": "query",
              "value": "={{ $node["Set Search Parameters"].json["query"] }}"
            },
            {
              "name": "resultsCount",
              "value": "={{ $node["SearXNG MCP Search"].json["result"]["total_results"] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Final Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Set Search Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Search Parameters": {
      "main": [
        [
          {
            "node": "SearXNG MCP Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SearXNG MCP Search": {
      "main": [
        [
          {
            "node": "Process Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Results": {
      "main": [
        [
          {
            "node": "Has Results?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Results?": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          },
          {
            "node": "Error Response",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Success Response": {
      "main": [
        [
          {
            "node": "Final Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Response": {
      "main": [
        [
          {
            "node": "Final Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "id": "searxng-mcp-workflow"
}