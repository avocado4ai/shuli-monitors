{
  "$schema": "https://grafana.com/jsonnet/schemas/v9/dashboard.json",
  "uid": "docling-overview",
  "title": "Docling Serve & MCP Overview",
  "timezone": "browser",
  "tags": ["docling", "mcp", "observability"],
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to use this dashboard",
      "id": 1,
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "### Docling Serve & MCP\n- Use the **Docling Host** & **MCP Queue** dropdowns to scope metrics to a single instance or queue.\n- Request rate and latency charts rely on `http_requests_total`/`http_request_duration_seconds_bucket`; verify Prometheus is scraping Docling Serve before relying on them.\n- All panels read from Prometheus (node exporter + Docling exporters), so make sure each container is scraped."
      }
    },
    {
      "type": "stat",
      "title": "Serve Uptime",
      "id": 2,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 4},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(max_over_time(up{job=\"docling-serve\", instance=~\"$docling_instance\"}[$__interval]))"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Active MCP Workers",
      "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 4},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"docling-mcp\", queue=~\"$mcp_queue\"})"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 2}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeSeries",
      "title": "HTTP Request Rate (rps)",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(http_requests_total{job=\"docling-serve\", instance=~\"$docling_instance\"}[$__rate_interval]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeSeries",
      "title": "HTTP Latency P95",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"docling-serve\", instance=~\"$docling_instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "type": "timeSeries",
      "title": "MCP Job Queue Depth",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (docling_job_queue_length{queue=~\"$mcp_queue\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeSeries",
      "title": "MCP Task Throughput",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "datasource": {
        "type": "prometheus",
        "uid": "eewyj5dtxw3r4a"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(docling_mcp_tasks_total{queue=~\"$mcp_queue\", status=\"completed\"}[$__rate_interval]))",
          "legendFormat": "{{queue}} completed"
        },
        {
          "refId": "B",
          "expr": "sum by (queue) (rate(docling_mcp_tasks_total{queue=~\"$mcp_queue\", status=\"failed\"}[$__rate_interval]))",
          "legendFormat": "{{queue}} failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "docling_instance",
        "label": "Docling Host",
        "datasource": {
          "type": "prometheus",
          "uid": "eewyj5dtxw3r4a"
        },
        "query": "label_values(up{job=\"docling-serve\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "type": "query",
        "name": "mcp_queue",
        "label": "MCP Queue",
        "datasource": {
          "type": "prometheus",
          "uid": "eewyj5dtxw3r4a"
        },
        "query": "label_values(docling_job_queue_length, queue)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "version": 1
}
