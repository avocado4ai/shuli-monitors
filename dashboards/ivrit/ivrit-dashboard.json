          },
          "format": "table",
          "rawSql": "SELECT created_at AS time, file_name, status, engine, model, language, diarize, speakers_count, segments_count, processing_time FROM jobs ORDER BY created_at DESC LIMIT 30",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
