    {
      "id": 7,
      "title": "Jobs Over Time by Status (fixed 12mo range)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "mysql",
        "uid": "ivrit-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "ivrit-mysql"
          },
          "format": "time_series",
          "rawSql": "SELECT FROM_UNIXTIME(FLOOR(UNIX_TIMESTAMP(created_at)/86400)*86400) AS time, status AS metric, count(*) AS value FROM jobs GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "timeFrom": "365d"
    },
    {
      "id": 8,
      "title": "Jobs by Status",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "mysql",
        "uid": "ivrit-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "ivrit-mysql"
          },
          "format": "table",
          "rawSql": "SELECT status, count(*) FROM jobs GROUP BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Avg Processing Time by Engine/Device (s)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "datasource": {
        "type": "mysql",
        "uid": "ivrit-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "ivrit-mysql"
          },
          "format": "table",
          "rawSql": "SELECT concat(engine,' (',device,')') AS metric, round(avg(processing_time),1) AS value FROM jobs WHERE processing_time IS NOT NULL GROUP BY engine, device ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
